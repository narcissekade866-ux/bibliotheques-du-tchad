# Copier ce fichier en .env (jamais commité) et renseigner les vraies valeurs.

# --- Général ---
NODE_ENV=production
# Port publié sur l'hôte (80 en standalone, 8080 derrière un reverse proxy Nginx)
PORT=80

# Connexion PostgreSQL (utilisateur applicatif à droits minimaux, jamais SUPERUSER)
PGHOST=db
PGPORT=5432
PGDATABASE=bibliotheques_tchad
PGUSER=
PGPASSWORD=

# Authentification (générer des valeurs aléatoires : openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# CORS — liste blanche explicite des origines autorisées, séparées par des virgules
CORS_ORIGIN=https://bibliofinder.org

# --- Frontend (Vite, utilisé uniquement au build) ---
VITE_API_URL=/api
