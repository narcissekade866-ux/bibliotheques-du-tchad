# Copier ce fichier en .env (jamais commité) et renseigner les vraies valeurs.

# --- Backend ---
NODE_ENV=development
PORT=3000

# Connexion PostgreSQL (utilisateur applicatif à droits minimaux, jamais SUPERUSER)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bibliotheques_tchad
PGUSER=
PGPASSWORD=

# Authentification
JWT_SECRET=
JWT_REFRESH_SECRET=

# CORS — liste blanche explicite des origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api
