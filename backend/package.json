{
  "name": "bibliotheques-du-tchad-backend",
  "version": "1.0.0",
  "description": "API Node.js/Express de la plateforme Bibliothèques du Tchad",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "import:kobo": "node src/scripts/import-kobo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
